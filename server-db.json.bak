  "reviews": [
    {
      "id": "rev-1-1",
      "movieNightId": "night-1",
      "user": "Max Smith",
      "rating": 5,
      "comment": "Peter Jackson's crowning achievement. 200 minutes flies by and the emotional punch never fades.",
      "isStarred": false,
      "createdAt": "2026-07-19T02:15:00.000Z"
    },
    {
      "id": "rev-1-2",
      "movieNightId": "night-1",
      "user": "James Macintosh",
      "rating": 5,
      "comment": "The ride of the Rohirrim still gives me goosebumps every single time. Perfect opening film for our club.",
      "isStarred": true,
      "createdAt": "2026-07-19T02:30:00.000Z"
    },
    {
      "id": "rev-1-3",
      "movieNightId": "night-1",
      "user": "Ash Macintosh",
      "rating": 4.5,
      "comment": "Samwise Gamgee is the true hero of Middle Earth. Jackson's scale remains unmatched 20+ years later.",
      "isStarred": false,
      "createdAt": "2026-07-19T03:00:00.000Z"
    },
    {
      "id": "rev-2-1",
      "movieNightId": "night-2",
      "user": "Ash Macintosh",
      "rating": 5,
      "comment": "Villeneuve crafts pure dread and moral ambiguity. Hugh Jackman and Jake Gyllenhaal at their absolute peaks.",
      "isStarred": false,
      "createdAt": "2026-08-02T01:45:00.000Z"
    },
    {
      "id": "rev-2-2",
      "movieNightId": "night-2",
      "user": "Max Smith",
      "rating": 4.5,
      "comment": "Hugh Jackman's bathroom hammer interrogation scene was pure intensity. Kept us debating for hours after.",
      "isStarred": true,
      "createdAt": "2026-08-02T02:10:00.000Z"
    },
    {
      "id": "rev-3-1",
      "movieNightId": "night-3",
      "user": "Madison Hill",
      "rating": 5,
      "comment": "Kate Winslet and Melanie Lynskey's chemistry is unforgettable. Such a poetic yet chilling slice of NZ history.",
      "isStarred": true,
      "createdAt": "2026-08-22T02:00:00.000Z"
    },
    {
      "id": "rev-3-2",
      "movieNightId": "night-3",
      "user": "Ash Macintosh",
      "rating": 4.5,
      "comment": "The clay world fantasy sequences set against Christchurch landscapes create something truly hypnotic.",
      "isStarred": false,
      "createdAt": "2026-08-22T02:20:00.000Z"
    },
    {
      "id": "rev-4-1",
      "movieNightId": "night-4",
      "user": "Amy Walsh",
      "rating": 5,
      "comment": "That Toxic strings sequence was iconic! Carey Mulligan delivers vengeance with terrifying elegance.",
      "isStarred": true,
      "createdAt": "2026-08-29T01:30:00.000Z"
    },
    {
      "id": "rev-4-2",
      "movieNightId": "night-4",
      "user": "James Macintosh",
      "rating": 4.5,
      "comment": "Sharp, subversive writing and a gut-punch finale that none of us anticipated. Terrific pick by Amy.",
      "isStarred": false,
      "createdAt": "2026-08-29T02:00:00.000Z"
    },
    {
      "id": "rev-5-1",
      "movieNightId": "night-5",
      "user": "Tom Sakai",
      "rating": 5,
      "comment": "Bong Joon Ho's pacing and tone control is masterclass. Every scene transition is pure cinematic gold.",
      "isStarred": false,
      "createdAt": "2026-09-12T02:15:00.000Z"
    },
    {
      "id": "rev-5-2",
      "movieNightId": "night-5",
      "user": "Ash Macintosh",
      "rating": 5,
      "comment": "The basement reveal and that rain-soaked descent back to the semi-basement apartment—flawless filmmaking.",
      "isStarred": true,
      "createdAt": "2026-09-12T02:40:00.000Z"
    },
    {
      "id": "rev-6-1",
      "movieNightId": "night-6",
      "user": "James Macintosh",
      "rating": 5,
      "comment": "Billy Mitchell walking in with the USA tie while Steve Wiebe sweats at the arcade is peak comedy.",
      "isStarred": true,
      "createdAt": "2026-09-26T02:00:00.000Z"
    },
    {
      "id": "rev-6-2",
      "movieNightId": "night-6",
      "user": "Max Smith",
      "rating": 4.5,
      "comment": "Funniest documentary we've ever watched. The entire room was shouting at the screen during the kill screen.",
      "isStarred": false,
      "createdAt": "2026-09-26T02:25:00.000Z"
    },
    {
      "id": "rev-7-1",
      "movieNightId": "night-7",
      "user": "Ash Macintosh",
      "rating": 4.5,
      "comment": "It’s tough to keep an audience engaged when a film is set in one location. Although this film does technically travel through fictional America, the road they walk is essentially one setting they never leave. To make it even harder for the director, we as the audience immediately know that all but one of the cast members will likely die. To overcome these there is a HEAVY reliance on the actors and the writing but its masterfully done in all aspects. The way they managed to get me to care so deeply about even the most despicable characters right before their demise by breaking them down, finally showing their true vulnerability was heartbreaking and so human. I will also say the plot twist at the end was a really left field hook I didn’t see coming so kudos to Stephen King on that one. 4.5/5 with the only draw back being the final scene felt like it had less weight than some of the previous deaths.",
      "isStarred": true,
      "createdAt": "2026-10-10T02:00:00.000Z"
    },
    {
      "id": "rev-7-2",
      "movieNightId": "night-7",
      "user": "Max Smith",
      "rating": 4.5,
      "comment": "Stephen King's dystopian road walk brought to life with brutal tension. Kept your heart pounding until the last mile.",
      "isStarred": false,
      "createdAt": "2026-10-10T02:15:00.000Z"
    }
  ],
  "overviews": [
    {
      "id": "ov-1784526660029",
      "movieNightId": "night-1",
      "title": "Lord of the Rings - more like “Samwise Gamgee not getting the recognition he deserves!!!!”",
      "author": "Ash Macintosh",
      "content": "Kicking off our inaugural Movie Club screening with the grand finale of Peter Jackson's legendary trilogy. Samwise Gamgee carried the entire fellowship on his shoulders, and honestly, the emotional resonance of this masterpiece only deepens with time. An unforgettable start to our club nights with the gang.",
      "imageUrl": "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=80",
      "createdAt": "2026-07-19T10:00:00.000Z"
    },
    {
      "id": "ov-1785626532933",
      "movieNightId": "night-2",
      "title": "Is Denis Villeneuve Lost in the Sauce?",
      "author": "Ash Macintosh",
      "content": "Tense, gripping, and relentlessly dark from the first frame to the final whistle. Hugh Jackman delivers a career-defining descent into parental desperation while Jake Gyllenhaal's twitchy Detective Loki grounds the mystery with pure grit. The moral ambiguity kept us debating well past midnight.",
      "imageUrl": "https://images.unsplash.com/photo-1478760329108-5c3ed9d495a0?auto=format&fit=crop&w=1200&q=80",
      "createdAt": "2026-08-02T10:00:00.000Z"
    },
    {
      "id": "ov-1787631699850",
      "movieNightId": "night-3",
      "title": "The Christchurch Girls High Experience",
      "author": "Ash Macintosh",
      "content": "A haunting local treasure that hit close to home. The fantasy dream sequences and the incredible breakout performances from Kate Winslet and Melanie Lynskey made this one of our most stylistically unique evenings. Tragic, vivid, and deeply atmospheric New Zealand cinema.",
      "imageUrl": "https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=1200&q=80",
      "createdAt": "2026-08-22T10:00:00.000Z"
    },
    {
      "id": "ov-1787916313632",
      "movieNightId": "night-4",
      "title": "Promise you’ll only notice Bo Burnham’s Giant Dome",
      "author": "Ash Macintosh",
      "content": "Carey Mulligan commands every scene with razor-sharp precision. The candy-colored aesthetic clashing against the biting, uncompromising revenge narrative left all of us stunned. A pitch-perfect modern thriller with an explosive soundtrack to match.",
      "imageUrl": "https://images.unsplash.com/photo-1509248961158-e54f6934749c?auto=format&fit=crop&w=1200&q=80",
      "createdAt": "2026-08-29T10:00:00.000Z"
    },
    {
      "id": "ov-1789126474474",
      "movieNightId": "night-5",
      "title": "Fannies, Crips, and (9/)11 Chips",
      "author": "Ash Macintosh",
      "content": "Pure cinematic perfection. Bong Joon Ho orchestrates genre shifts with breathtaking elegance—hilarious satire in the first half leading into unbearable suspense in the basement. Every single member was on the edge of their seat. Unquestionably one of our highest-rated nights.",
      "imageUrl": "https://images.unsplash.com/photo-1527224857830-43a7acc85260?auto=format&fit=crop&w=1200&q=80",
      "createdAt": "2026-09-12T10:00:00.000Z"
    },
    {
      "id": "ov-1790727902528",
      "movieNightId": "night-6",
      "title": "An Ode to Steve Wiebe - Our Autistic King of Kong",
      "author": "Ash Macintosh",
      "content": "You couldn't script better characters than Steve Wiebe and Billy Mitchell if you tried. The quintessential David versus Goliath documentary that had the entire room cheering for every single hammer smash and barrel jump. An absolute crowd pleaser that exceeded all expectations.",
      "imageUrl": "https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=1200&q=80",
      "createdAt": "2026-09-26T10:00:00.000Z"
    },
    {
      "id": "ov-1791959573924-98033e21",
      "movieNightId": "night-7",
      "title": "But, how do they shit?",
      "author": "Ash Macintosh",
      "content": "It’s tough to keep an audience engaged when a film is set in one location. Although this film does technically travel through fictional America, the road they walk is essentially one setting they never leave. To make it even harder for the director, we as the audience immediately know that all but one of the cast members will likely die. To overcome these there is a HEAVY reliance on the actors and the writing but its masterfully done in all aspects. The way they managed to get me to care so deeply about even the most despicable characters right before their demise by breaking them down, finally showing their true vulnerability was heartbreaking and so human. I will also say the plot twist at the end was a really left field hook I didn’t see coming so kudos to Stephen King on that one. 4.5/5 with the only draw back being the final scene felt like it had less weight than some of the previous deaths.",
      "imageUrl": "https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?auto=format&fit=crop&w=1200&q=80",
      "createdAt": "2026-10-14T00:01:04.566Z"
    }
  ],
