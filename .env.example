# Settings the server reads. On the live site these are set on the Cloud Run service
# (secrets come from Google Secret Manager); for local development, set them in your shell.

# SESSION_SECRET: Required in production. Signs login sessions; changing it signs everyone out.
SESSION_SECRET=

# DB_PATH: Optional. Path to the database file. Defaults to /app/db-volume/server-db.json when
# the storage bucket is mounted, otherwise ./server-db.json. Photos are kept in an "images"
# folder next to it.
DB_PATH=

# ALLOW_DB_INIT: Optional. In production the server refuses to create a new, empty database if
# the file is missing (usually a sign the bucket isn't mounted). Set to "true" only to set up a
# brand-new site.
ALLOW_DB_INIT=

# APP_URL: Public address of the site, used for links and photos in club emails.
APP_URL=https://www.movieclub.co.nz

# TMDB_API_KEY: The Movie Database (TMDb) v3 key, used to look up posters and movie details.
TMDB_API_KEY=

# GEMINI_API_KEY: Optional. Used to look up movie details when TMDb has no match.
GEMINI_API_KEY=

# SMTP settings for club emails. If SMTP_HOST is not set, emails are simulated and only logged.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
