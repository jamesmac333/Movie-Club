ter-spacing: -0.02em;\">\n                A Selection is Made!\n              </h1>\n              <div style=\"font-size: 13px; color: #d4d4d8;\">\n                Your host <strong style=\"color: #fbbf24; font-size: 15px;\">Max Smith</strong> has chosen the feature presentation for <strong style=\"color: #ffffff;\">Fri, 9 Oct 2026</strong> at 19:00 NZT.\n              </div>\n            </td>\n          </tr>\n\n          <!-- Movie Poster & Metadata Card -->\n          <tr>\n            <td style=\"padding: 28px 32px; background-color: #14100e;\">\n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                  \n                  <td width=\"130\" valign=\"top\" style=\"padding-right: 22px;\">\n                    <img src=\"https://image.tmdb.org/t/p/w500/wobVTa99eW0ht6c1rNNzLkazPtR.jpg\" alt=\"The Long Walk\" width=\"130\" style=\"border-radius: 14px; border: 2px solid #3f2e21; display: block; box-shadow: 0 8px 24px rgba(0,0,0,0.8);\" />\n                  </td>\n                  \n                  <td valign=\"top\">\n                    \n                    <span style=\"display: inline-block; padding: 2px 8px; background-color: #27272a; border: 1px solid #3f3f46; border-radius: 6px; font-size: 10px; font-weight: bold; color: #a1a1aa; font-family: 'Courier New', Courier, monospace; margin-bottom: 8px;\">\n                      R\n                    </span>\n                    \n                    <h2 style=\"margin: 0 0 6px; font-size: 22px; font-weight: 800; color: #ffffff;\">\n                      The Long Walk <span style=\"font-size: 16px; color: #71717a; font-weight: normal;\">(2025)</span>\n                    </h2>\n                    \n                    <p style=\"margin: 0 0 12px; font-size: 13px; color: #fbbf24;\">\n                      Director: <strong style=\"color: #ffffff;\">Francis Lawrence</strong>\n                       • 108 min\n                       • Science Fiction, Thriller, Horror\n                    </p>\n\n                    <p style=\"margin: 0; font-size: 13px; line-height: 1.6; color: #a1a1aa;\">\n                      In a dystopian 1970s America, fifty teenage boys take part in a deadly annual walking contest, forced to maintain a minimum pace or be executed, until only one survivor remains.\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Schedule Callout Box -->\n          <tr>\n            <td style=\"padding: 0 32px 24px;\">\n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color: #1c1511; border: 1px solid #38271a; border-radius: 16px; padding: 16px 20px;\">\n                <tr>\n                  <td align=\"center\">\n                    <span style=\"font-size: 11px; font-family: 'Courier New', Courier, monospace; color: #a1a1aa; text-transform: uppercase; letter-spacing: 0.1em;\">\n                      Mark Your Calendar\n                    </span>\n                    <div style=\"font-size: 16px; font-weight: bold; color: #fbbf24; margin-top: 4px;\">\n                      Fri, 9 Oct 2026 • 7:00 PM NZT\n                    </div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Enter Site Button -->\n          <tr>\n            <td align=\"center\" style=\"padding: 0 32px 32px;\">\n              <a href=\"https://movieclub.local\" style=\"display: inline-block; background-color: #f59e0b; color: #09090b; font-weight: bold; font-size: 13px; text-decoration: none; padding: 12px 28px; border-radius: 12px; letter-spacing: 0.05em; text-transform: uppercase; box-shadow: 0 4px 16px rgba(245, 158, 11, 0.4);\">\n                View Details & Trailer on Site →\n              </a>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td