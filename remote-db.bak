• OFFICIAL SESSION CHRONICLE\n                    </span>\n                    <h1 style=\"margin: 10px 0 6px; font-size: 26px; font-weight: 800; font-family: Georgia, serif; font-style: italic; color: #09090b; letter-spacing: -0.02em;\">\n                      Promise you’ll only notice Bo Burnham’s Giant Dome\n                    </h1>\n                    <p style=\"margin: 0; font-size: 13px; color: #52525b;\">\n                      Curated & Written by <strong style=\"color: #b45309;\">Ash Macintosh</strong> • Session of Fri, 28 Aug 2026\n                    </p>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Hero Gathering Photo -->\n          \n          <tr>\n            <td style=\"padding: 0; background-color: #f4f4f5; text-align: center;\">\n              <img src=\"https://images.unsplash.com/photo-1509248961158-e54f6934749c?auto=format&fit=crop&w=1200&q=80\" alt=\"Promise you’ll only notice Bo Burnham’s Giant Dome\" style=\"width: 100%; max-height: 440px; object-fit: cover; display: block; border-bottom: 1px solid #e7e5e4;\" />\n            </td>\n          </tr>\n          \n\n          <!-- Film Badge & Quick Facts -->\n          \n          <tr>\n            <td style=\"padding: 22px 32px; background-color: #fdfbf7; border-bottom: 1px solid #f2ede4;\">\n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                  \n                  <td width=\"80\" valign=\"top\" style=\"padding-right: 18px;\">\n                    <img src=\"https://image.tmdb.org/t/p/w500/2h4EkRxy36zSsBDkijXSUMJFDaz.jpg\" alt=\"Promising Young Woman\" width=\"80\" style=\"border-radius: 12px; border: 1px solid #e5e7eb; display: block; box-shadow: 0 4px 14px rgba(0,0,0,0.08);\" />\n                  </td>\n                  \n                  <td valign=\"middle\">\n                    <span style=\"font-family: 'Courier New', Courier, monospace; font-size: 10px; color: #b45309; font-weight: bold; text-transform: uppercase; letter-spacing: 0.15em;\">FEATURED FILM</span>\n                    <h2 style=\"margin: 4px 0; font-size: 20px; font-weight: bold; color: #09090b;\">Promising Young Woman <span style=\"font-size: 14px; color: #71717a; font-weight: normal;\">(2020)</span></h2>\n                    <p style=\"margin: 0; font-size: 13px; color: #52525b; line-height: 1.4;\">\n                      Directed by <strong style=\"color: #18181b;\">Emerald Fennell</strong> • Host: <strong style=\"color: #b45309;\">Amy Walsh</strong>\n                       • 114 min\n                       • Thriller, Crime, Drama\n                    </p>\n                    \n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          \n\n          <!-- Ash's Night Overview Narrative Body (Light White Background with Dark, Ultra-Legible Text) -->\n          <tr>\n            <td style=\"padding: 32px 32px; background-color: #ffffff;\">\n              <h3 style=\"margin: 0 0 14px; font-size: 12px; font-family: 'Courier New', Courier, monospace; font-weight: bold; letter-spacing: 0.2em; text-transform: uppercase; color: #71717a;\">\n                THE NIGHT'S CHRONICLE\n              </h3>\n              <div style=\"font-size: 16px; line-height: 1.85; color: #18181b; font-family: Georgia, 'Times New Roman', serif; white-space: pre-wrap;\">Carey Mulligan commands every scene with razor-sharp precision. The candy-colored aesthetic clashing against the biting, uncompromising revenge narrative left all of us stunned. A pitch-perfect modern thriller with an explosive soundtrack to match.</div>\n            </td>\n          </tr>\n\n          <!-- Ash's Top Review Highlight (if present) -->\n          \n\n          <!-- Call to action button -->\n          <tr>\n            <td align=\"center\" style=\"padding: 8px 32px 36px; background-color: #ffffff;\">\n           